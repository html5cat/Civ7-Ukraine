<?xml version="1.0" encoding="utf-8"?>
<!-- Ukraine: Historical Continuity — Pontic Scythia → Kyivan Rus' → Ukraine.
     Structure mirrors working Workshop civ mods (Nepal DLC / Bharat patterns):
     plain-text Properties, age References, always-loaded shared civ rows,
     age-gated units/abilities, shell config for setup screen. -->
<Mod id="ukraine-historical-continuity" version="3" xmlns="ModInfo">
	<Properties>
		<Name>Ukraine: Historical Continuity</Name>
		<Description>Historically grounded all-age path: Pontic Scythia (Antiquity), Kyivan Rus' (Exploration), and Ukraine (Modern), with unique abilities and units.</Description>
		<Authors>Yurik and Codex</Authors>
		<Package>Mod</Package>
		<EnabledByDefault>1</EnabledByDefault>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<!-- Ensure age modules load before age-gated FK content (unit replaces, etc.). -->
	<References>
		<Mod id="age-antiquity" title="LOC_MODULE_AGE_ANTIQUITY_NAME"/>
		<Mod id="age-exploration" title="LOC_MODULE_AGE_EXPLORATION_NAME"/>
		<Mod id="age-modern" title="LOC_MODULE_AGE_MODERN_NAME"/>
	</References>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet/>
		</Criteria>
		<Criteria id="antiquity-age-current">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-current">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="modern-age-current">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- Always-on gameplay: types, civs, text, icons, shared wiring.
		     Icons + visual remaps must be in always groups (not age-gated)
		     or unit flags/models fail to register. -->
		<ActionGroup id="ukraine-continuity-game-always" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-shared.xml</Item>
					<Item>data/loading-info.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/ModuleText.xml</Item>
					<Item>text/CivilizationText.xml</Item>
				</UpdateText>
				<UpdateIcons>
					<Item>data/icons/civilization-icons.xml</Item>
				</UpdateIcons>
				<UpdateVisualRemaps>
					<Item>data/visual-remaps.xml</Item>
				</UpdateVisualRemaps>
				<ImportFiles>
					<Item>assets/civ_sym_ukraine_continuity.png</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>

		<!-- Antiquity: Pontic Scythia abilities + Saka Horse Archer. -->
		<ActionGroup id="ukraine-continuity-antiquity" scope="game" criteria="antiquity-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-antiquity.xml</Item>
					<Item>data/civilizations-antiquity-gameeffects.xml</Item>
					<Item>data/units-antiquity.xml</Item>
					<Item>data/units-antiquity-gameeffects.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<!-- Exploration: Kyivan Rus' abilities + Druzhina. -->
		<ActionGroup id="ukraine-continuity-exploration" scope="game" criteria="exploration-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-exploration.xml</Item>
					<Item>data/civilizations-exploration-gameeffects.xml</Item>
					<Item>data/units-exploration.xml</Item>
					<Item>data/units-exploration-gameeffects.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<!-- Modern: Ukraine abilities + Sich Riflemen. -->
		<ActionGroup id="ukraine-continuity-modern" scope="game" criteria="modern-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-modern.xml</Item>
					<Item>data/civilizations-modern-gameeffects.xml</Item>
					<Item>data/units-modern.xml</Item>
					<Item>data/units-modern-gameeffects.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>

		<!-- Shell / setup screen. Icons + remaps also here so setup/flags resolve. -->
		<ActionGroup id="ukraine-continuity-shell" scope="shell" criteria="always">
			<Actions>
				<ImportFiles>
					<Item>assets/civ_sym_ukraine_continuity.png</Item>
				</ImportFiles>
				<UpdateIcons>
					<Item>data/icons/civilization-icons.xml</Item>
				</UpdateIcons>
				<UpdateVisualRemaps>
					<Item>data/visual-remaps.xml</Item>
				</UpdateVisualRemaps>
				<UpdateDatabase>
					<Item>config/config.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/ModuleText.xml</Item>
					<Item>text/CivilizationText.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/ModuleText.xml</File>
		<File>text/CivilizationText.xml</File>
	</LocalizedText>
</Mod>
